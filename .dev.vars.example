# Copy to `.dev.vars` (gitignored) for `wrangler dev`. Do NOT commit .dev.vars.
# For production, set each with: wrangler secret put <NAME>

# Required — signs session JWTs. Use a long random string.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# One-time first-admin setup. Send as x-bootstrap-secret to /admin/bootstrap.
# Use a separate random secret in production, then remove it after setup.
ADMIN_BOOTSTRAP_SECRET="dev-only-change-me-bootstrap"

# Optional in explicit development only. BOTH are required for real payments.
# Get these from your Flutterwave dashboard when wiring real payments.
FLW_SECRET_KEY=""
FLW_WEBHOOK_HASH=""

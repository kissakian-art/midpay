{
  "expo": {
    "name": "MidPay",
    "slug": "midpay",
    "owner": "kissa-kian",
    "version": "0.1.0",
    "scheme": "midpay",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kissakian.midpay"
    },
    "android": {
      "package": "com.kissakian.midpay",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "MidPay uses the camera to record and film your posts.",
          "microphonePermission": "MidPay uses the microphone to record audio for your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MidPay needs access to your library to upload existing videos."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://midpay-backend.midpay.workers.dev",
      "eas": {
        "projectId": "ee16880d-4894-426d-a47e-898b01363ed9"
      }
    }
  }
}
